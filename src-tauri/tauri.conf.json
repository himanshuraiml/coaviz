{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "COAViz",
  "version": "1.1.0",
  "identifier": "com.himanshuraiml.coaviz",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "COAViz - Interactive Computer Organization & Architecture Visualizer",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Interactive Computer Organization & Architecture Educational Visualizer",
    "longDescription": "High-impact, interactive visualizer covering 15 Computer Organization & Architecture simulators across 5 university curriculum units and 60 lecture sessions.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/himanshuraiml/coaviz/releases/latest/download/latest.json"
      ]
    }
  }
}

